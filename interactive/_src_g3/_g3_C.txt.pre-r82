    /* ▼▼▼ 替换区 C：本案例关卡配置 GAME_CONFIG（两阶段五关，换新案例整块替换）▼▼▼
       ★ 表达式一律分式写法：tk('I','CQ') 下标、{box:1} 虚线框、fr([分子],[分母]) 分式
       ★ pts 合计=100 且各 fill/mix 空数整除；④关 gate 门控 + targets 二级菜单（串/并、置零）
       ★ 本案例（双电源共射·分段发射极电阻）：计分 [12, 6, 43, 18, 21] = 100
         （第72轮：第2关 18→6，3 个量各 2 分；腾出的 12 分调入第3关 4 个框架题 3→6 分）
         —— ①6 项×2  ②3 量各 2 分共 6  ③4 框架×6 + 填空 19 分 = 43  ④8 项×2 + 五问 2  ⑤3 框架×4 + 8 空共 9 分 = 21 */
    // ---- 案例配置（★ 换案例改这里；tk(主,下标) 为文本片段） ----
    // 案例：双电源（±V_CC）共射放大电路 —— R_e1 + R_e2 分段发射极电阻，C_E 只旁路 R_e2（部分旁路）
    //   静态：V_BQ≈0（R_B 接地、I_BQ 很小）→ I_CQ≈I_EQ=(V_EE−V_BE)/(R_e1+R_e2)
    //         → I_BQ=I_CQ/β → V_CEQ≈V_CC+V_EE−I_CQ(R_C+R_e1+R_e2)
    //   动态：C_E 短路只旁路 R_e2，R_e1 保留 → A_v=−β(R_C∥R_L)/(r_be+(1+β)R_e1)
    //         R_i=R_B∥[r_be+(1+β)R_e1]，R_o≈R_C
    // 已知符号：V_CC、V_EE、R_C、R_e1、R_e2、R_B、R_S、R_L、β；V_BE=0.7V；r_be 由 Q 点求出
    //   （填空中 r_be 点晶体管 comp-t 作答，第 4 关后晶体管已换成微变模型，点击模型同样按 comp-t 计）
    function tk(main, sub) { return { main: main, sub: sub }; }
    function fr(num, den) { return { frac: [num, den] }; }   // 分式（上下式）
    const GAME_CONFIG = {
        phases: [
            {
                name: '静态分析',
                steps: [
                    {
                        kind: 'draw', mode: 'remove', title: '第 1 关 · 绘制直流通路', pts: 12, short: '绘制直流通路',
                        q: '先处理信号源与 2 个电源，再悬停电容选择正确的处理方式',
                        subLine: '悬停元件，在菜单里选短路/断路、置零/保留',
                        gateMsg: '请先处理信号源与 2 个电源，再处理电容。',
                        gateTodo: '当前：先处理信号源与 2 个电源',
                        gateDoneMsg: '信号源与电源已处理，现在处理三只电容',
                        targets: [
                            { id: 'comp-c1', name: '输入耦合电容CB', menu: [
                                { label: '短路', act: 'cap-short', ok: false },
                                { label: '断路', act: 'cap-open', ok: true }] },
                            { id: 'comp-c2', name: '输出耦合电容CC', menu: [
                                { label: '短路', act: 'cap-short', ok: false },
                                { label: '断路', act: 'cap-open', ok: true }] },
                            { id: 'comp-ce', name: '旁路电容CE', menu: [
                                { label: '短路', act: 'cap-short', ok: false },
                                { label: '断路', act: 'cap-open', ok: true }] },
                            { id: 'comp-src', name: '信号源Vs', menu: [
                                { label: '置零', sub: [
                                    { label: '短路', act: 'vs-short', ok: true },
                                    { label: '断路', act: 'vs-open', ok: false }] },
                                { label: '保留', act: 'vs-keep', ok: false }] },
                            { id: 'comp-vcc', name: '直流电源+Vcc', menu: [
                                { label: '置零', sub: [
                                    { label: '短路', act: 'vcc-gnd', ok: false },
                                    { label: '断路', act: 'vcc-open', ok: false }] },
                                { label: '保留', act: 'vcc-keep', ok: true }] },
                            { id: 'comp-vee', name: '直流电源−Vee', menu: [
                                { label: '置零', sub: [
                                    { label: '短路', act: 'vee-gnd', ok: false },
                                    { label: '断路', act: 'vee-open', ok: false }] },
                                { label: '保留', act: 'vee-keep', ok: true }] }
                        ],
                        // 门控：Vs 与两个直流电源必须先处理完，三只电容才解锁——否则 C_B 断路会连锁移除 Vs，导致关卡无法完成
                        gate: ['comp-src', 'comp-vcc', 'comp-vee'],
                        // 选「断路」后，被隔断回路里的元件与导线连锁移除（fadeWith 半隐 0.15）；
                        // fadeWithFull = 彻底移除（opacity 0）：节点圆（断开后只剩两条导线，不再是节点）与接地符号
                        fadeWith: {
                            'comp-c1': ['wire-vi-top', 'wire-base-in', 'comp-vi', 'wire-vi-gnd', 'comp-src', 'wire-rs-top', 'wire-rs-bot', 'comp-rs'],
                            'comp-c2': ['wire-collector', 'wire-c2-out', 'comp-rl', 'wire-rl-a', 'wire-rl-b', 'comp-vo'],
                            'comp-ce': ['wire-ce-a', 'comp-ce', 'wire-ce-b']
                        },
                        fadeWithFull: {
                            'comp-c1': ['node-base', 'comp-gnd-src'],
                            'comp-c2': ['node-collector', 'comp-gnd-rl'],
                            'comp-ce': ['node-re', 'comp-gnd-ce']
                        },
                        announce: '进入第一关，绘制直流通路。先处理信号源与两个电源，再悬停电容，在弹出的菜单里选择正确的处理方式，答对获得12分。',
                        doneSay: '直流通路画好了。',
                        why: '画直流通路：C_B、C_C、C_E 开路；输入信号源 Vs 置零后短路（电压源置零即短路），随 C_B 断开的输入回路一并移除；两个直流电源都保留。'
                    },
                    {
                        kind: 'qorder', title: '第 2 关 · Q点计算步骤', pts: 6, short: 'Q点计算步骤',
                        q: '按计算顺序，依次点击电路中要计算的电量',
                        subLine: '三种计算顺序都对，按其中之一依次点击',
                        // ★合法计算顺序（第76轮用户指定：静态工作点计算顺序调整）：
                        //   ① 先算 I_EQ（第76轮新增，首步点发射极的 I_EQ）：I_EQ → I_CQ → I_BQ → V_CEQ
                        //   ② 先算 I_CQ（省 I_EQ）：I_CQ → I_BQ → V_CEQ
                        //   ③ 先算 I_BQ：I_BQ → I_CQ → V_CEQ
                        //   其中 ① ② 的 I_BQ 与 V_CEQ 可以交换顺序（两条都算对）
                        //   每步可写「id」或「可接受 id 数组」；seqs 为多条合法顺序（引擎按已点前缀取并集判定）
                        seqs: [
                            ['q-ieq', 'q-icq', 'q-ibq', 'q-vceq'],
                            ['q-ieq', 'q-icq', 'q-vceq', 'q-ibq'],
                            ['q-icq', 'q-ibq', 'q-vceq'],
                            ['q-icq', 'q-vceq', 'q-ibq'],
                            ['q-ibq', 'q-icq', 'q-vceq']
                        ],
                        // 每条顺序对应的静态计算路线（记录在第 2 关首步作答里，决定第 3 关用哪套子步）：
                        //   ① ② 首步 I_EQ → 'eq'（subs）｜③ ④ 首步 I_CQ → 'cq'（subsC）｜⑤ 首步 I_BQ → 'base'（subsBase）
                        routes: ['eq', 'eq', 'cq', 'cq', 'base'],
                        names: { 'q-ieq': 'I<tspan class="sub">EQ</tspan>', 'q-ibq': 'I<tspan class="sub">BQ</tspan>',
                                 'q-icq': 'I<tspan class="sub">CQ</tspan>', 'q-vceq': 'V<tspan class="sub">CEQ</tspan>' },
                        announce: '进入第二关，电路中已标出各电量。按计算顺序依次点击对应的电量，答对获得6分。',
                        extra: '点错了扣2分，可以继续点。'
                    },
                    {
                        // 框架 + 表达式交错关：每个电量先选框架、再填表达式。
                        // ★第76轮：按第 2 关所选路线分发「三套方案」，且 I_BQ / V_CEQ 两块顺序跟随第 2 关实际点击顺序
                        //   路线 eq（第2关首步点 I_EQ）：I_CQ≈□=(V_EE−V_BE)/[R_B/(1+β)+R_e1+R_e2]（□ 填 I_EQ，点发射极标注）
                        //        → 简化 I_CQ≈I_EQ≈(V_EE−V_BE)/(R_e1+R_e2) → I_BQ=I_CQ/β → V_CEQ 同式
                        //   路线 cq（第2关首步点 I_CQ，省 I_EQ）：I_CQ≈I_EQ=(V_EE−V_BE)/[R_B/(1+β)+R_e1+R_e2]
                        //        → 简化 → I_BQ=I_CQ/β → V_CEQ
                        //   路线 base（第2关首步点 I_BQ）：I_BQ=(V_EE−V_BE)/[R_B+(1+β)(R_e1+R_e2)]
                        //        → 简化 I_BQ≈(V_EE−V_BE)/[β(R_e1+R_e2)] → I_CQ=β·I_BQ（第72轮：两因子可交换）→ V_CEQ
                        // 每套 8 子步（4 框架 + 4 填空），分值各自配平到 43（框架 4×6=24 + 填空 19）
                        //   eq：主式 7 空 7 分（首位 I_EQ；V_EE 由 2 分降为 1 分配平）/ 简化 4 / I_BQ 2 / V_CEQ 6
                        //   cq：主式 6 空 7 分（V_EE 2 分）/ 简化 4 / I_BQ 2 / V_CEQ 6
                        //   base：主式 6 空 6 分 / 简化 5 空 5 分 / I_CQ 2 空 2 分 / V_CEQ 6 空 6 分
                        // 闪烁提示改用子步自带的 qid 字段（第76轮）；I_BQ / V_CEQ 子步带 blk 标记供引擎交换两块
                        kind: 'mix', title: '第 3 关 · Q点计算', pts: 43, short: 'Q点计算',
                        subLine: '每个电量先选表达式框架，再点虚线框填表达式',
                        // ===== 方案①（subs）：先算 I_EQ —— 第 2 关首步点 I_EQ 时走这套（第76轮新增） =====
                        //   ★用户指定：框架与填空都不增加选项，只把原「I_CQ≈I_EQ」里的 I_EQ 变成方框 ——
                        //   该方框点发射极标注 q-ieq 作答，表示「先算 I_EQ」；其余子步与 subsC 完全一致
                        subs: [
                            {
                                type: 'fw', name: 'I<tspan class="sub">CQ</tspan>≈I<tspan class="sub">EQ</tspan> 框架', qpts: 6, pen: 2,
                                qid: 'q-ieq',
                                fwQ: '集电极电流 I<tspan class="sub">CQ</tspan> ≈ I<tspan class="sub">EQ</tspan> 的表达式框架：',
                                // 先算 I_EQ：式子左边 I_EQ 的位置为方框（框架内以方框示意）
                                //   干扰项②分母漏掉 R_B 的 (1+β) 分流（写成 R_B+R_e1+R_e2）；③分子加减号写反
                                frameworks: [
                                    { tokens: [tk('I', 'CQ'), tk('≈'), { box: 1 }, tk('='), fr([{ box: 1 }, tk('−'), { box: 1 }], [fr([{ box: 1 }], [tk('1'), tk('+'), { box: 1 }]), tk('+'), { box: 1 }, tk('+'), { box: 1 }])], correct: true },
                                    { tokens: [tk('I', 'CQ'), tk('≈'), { box: 1 }, tk('='), fr([{ box: 1 }, tk('−'), { box: 1 }], [{ box: 1 }, tk('+'), { box: 1 }, tk('+'), { box: 1 }])] },
                                    { tokens: [tk('I', 'CQ'), tk('≈'), { box: 1 }, tk('='), fr([{ box: 1 }, tk('+'), { box: 1 }], [fr([{ box: 1 }], [tk('1'), tk('+'), { box: 1 }]), tk('+'), { box: 1 }, tk('+'), { box: 1 }])] }
                                ]
                            },
                            {
                                type: 'fill', name: 'I<tspan class="sub">CQ</tspan>≈I<tspan class="sub">EQ</tspan> 表达式',
                                // 7 空 7 分：首位 I_EQ（先算 I_EQ → 点发射极标注 q-ieq）；V_EE 由 2 分降为 1 分配平
                                fullExpr: [[tk('I', 'CQ'), tk('≈'), { box: 1 }, tk('='), fr([{ box: 1 }, tk('−'), { box: 1 }], [fr([{ box: 1 }], [tk('1'), tk('+'), { box: 1 }]), tk('+'), { box: 1 }, tk('+'), { box: 1 }])]],
                                blanks: [
                                    { ansIds: ['q-ieq'], label: [tk('I', 'EQ')], pts: 1 },
                                    { ansIds: ['comp-vee'], label: [tk('V', 'EE')], pts: 1 },
                                    { ansIds: ['q-vbe', 'comp-t'], label: [tk('V', 'BE')], pts: 1 },
                                    { ansIds: ['comp-rb'], label: [tk('R', 'B')], pts: 1 },
                                    { ansIds: ['q-beta', 'comp-t'], label: [tk('β')], pts: 1 },
                                    { ansIds: ['comp-re1', 'comp-re2'], grp: 'ieq-den',
                                      labels: { 'comp-re1': [tk('R', 'E1')], 'comp-re2': [tk('R', 'E2')] },
