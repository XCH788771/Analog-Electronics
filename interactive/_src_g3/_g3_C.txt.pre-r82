                                fullExpr: [[tk('I', 'CQ'), tk('≈'), tk('I', 'EQ'), tk('≈'), fr([{ box: 1 }, tk('−'), { box: 1 }], [{ box: 1 }, tk('+'), { box: 1 }])]],
                                blanks: [
