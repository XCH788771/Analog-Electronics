                });"""),

# ---------- 24. 子步进度圆点 >6 步时去掉序号（第 3 关 8 子步，带序号会顶出面板右缘） ----------
("        const dots = mx.subs.map((s2, k) => (k < mx.si ? '✓' : (k === mx.si ? '▶' : '·')) + (k + 1)).join(' ');",
 "        // 子步 >6 时省略序号（第69轮）：8 子步带序号会超出面板宽度，仅保留 ✓/▶/· 状态点\n        const dots = mx.subs.map((s2, k) => (k < mx.si ? '✓' : (k === mx.si ? '▶' : '·')) + (mx.subs.length <= 6 ? (k + 1) : '')).join(' ');"),

