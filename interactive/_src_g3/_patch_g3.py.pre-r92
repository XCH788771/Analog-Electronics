#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""cj-g3 引擎补丁：把「双电源共射」案例专属的引擎改造应用到 cj-g3.html。
   在 _build_g3.py 生成页面后运行（幂等：已打过补丁则跳过）。"""
import io, os, sys

BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
P = os.path.join(BASE, 'cj-g3.html')

def rd(p):
    with io.open(p, encoding='utf-8') as f: return f.read()
def wr(p, s):
    with io.open(p, 'w', encoding='utf-8', newline='\n') as f: f.write(s)

s = rd(P)
MARK = '/* ==== cj-g3 引擎补丁（勿手改，由 _patch_g3.py 生成） ==== */'
if MARK in s:
    print('补丁已存在，跳过'); sys.exit(0)

REPS = [
# ---------- 1. resetCircuit：清零清单换成新 fx/state id ----------
("""        ['fx-c1', 'fx-c2', 'fx-ce', 'fx-vi', 'fx-vcc', 'fx-vs', 'fx-re', 'fx-tmodel', 'rarr-rb1', 'rarr-rc',
         'fx-t-rbe', 'fx-t-src', 'fx-t-ib', 'fx-t-ic', 'fx-dot-b', 'fx-dot-c', 'fx-dot-e',
         'eq-layer', 'eq-rb1', 'eq-rb2'].forEach(id => {
            const f = document.getElementById(id);
            if (f) { f.style.opacity = '0'; f.style.pointerEvents = ''; }
        });
        document.querySelectorAll('.vcc-label, .rb2-label').forEach(t => { t.style.opacity = ''; t.style.visibility = ''; });""",
 """        ['fx-c1', 'fx-c2', 'fx-ce', 'fx-vcc', 'fx-vee', 'fx-vs', 'fx-re2', 'fx-gnd-rc', 'fx-gnd-e',
         'fx-gnd-rail', 'fx-gnd-jct', 'fx-re2-wire',
         'fx-tmodel', 'rarr-rc',
         'fx-t-rbe', 'fx-t-src', 'fx-t-ib', 'fx-t-ic', 'fx-dot-b', 'fx-dot-c', 'fx-dot-e',
         'eq-layer', 'eq-rb', 'eq-re1'].forEach(id => {
            const f = document.getElementById(id);
            if (f) { f.style.opacity = '0'; f.style.pointerEvents = ''; }
        });
        // 第87轮：等效层可作答件隐藏时补 hit-off——eq-rb/eq-re1 的 rect.hot 被
        //   `.interactive rect[fill="none"]{PE:all}` 重新赋权，隐形热区会参与 elementFromPoint、
        //   压住默认态电量标注（实测：eq-rb 热区盖住 q-ibq 文字 → I_BQ 点击无反应，与 qlabel-layer 同款）
        ['eq-rb', 'eq-re1'].forEach(id => { const f = document.getElementById(id); if (f) f.classList.add('hit-off'); });
        document.querySelectorAll('.vcc-label, .vee-label').forEach(t => { t.style.opacity = ''; t.style.visibility = ''; });
        // 第91轮：第4关整理态/等效态位移复位 + 整理态接缝补线收起
        tidyClear();
        { const f = document.getElementById('fx-tidy-lines'); if (f) { f.style.opacity = '0'; f.style.pointerEvents = ''; } }"""),

# ---------- 2. nextHint：CAPS/RES 换成本案例清单 ----------
("""    // 正确作答后的追加提示语：按当前进度决定下一句该做什么（无提示返回 ''）
    //   ① 门控电源（Vs / +Vcc）处理完 → 请选择电容处理方式
    //   ② 第 4 关三只电容处理完 → 请选择阿尔义、阿尔B1和阿尔C的整理方式
    //   ③ 第 4 关三个电阻全部处理完 → 请等效 BJT""",
 """    // 正确作答后的追加提示语：按当前进度决定下一句该做什么（无提示返回 ''）
    //   ① 门控电源（Vs / +Vcc / −Vee）处理完 → 请选择电容处理方式
    //   ② 第 4 关三只电容处理完 → 请判断 RE2 与 RE1 的去留（顺序任选）、并把 R_C 下移接地
    //   ③ 第 4 关整理步骤全部处理完 → 请等效 BJT"""),
("""        const CAPS = ['comp-c1', 'comp-c2', 'comp-ce'];
        const RES = ['comp-re', 'comp-rb1', 'comp-rc'];
        if (RES.indexOf(id) < 0 && CAPS.indexOf(id) < 0) return '';
        const resDone = !!(d.found['comp-re'] && d.moved && d.moved['comp-rb1'] && d.moved['comp-rc']);
        if (CAPS.indexOf(id) >= 0 && CAPS.every(x => d.found[x]) && !resDone) return '请选择阿尔义、阿尔B1和阿尔C的整理方式。';""",
 """        const CAPS = ['comp-c1', 'comp-c2', 'comp-ce'];
        const RES = ['comp-re2', 'comp-re1', 'comp-rc'];
        if (RES.indexOf(id) < 0 && CAPS.indexOf(id) < 0) return '';
        const resDone = !!(d.found['comp-re2'] && d.found['comp-re1'] && d.moved && d.moved['comp-rc']);
        // 本提示语由 saySeq 播报（语音串）：不得出现带下标的符号原文（会被念出「下划线」）→ 用注音（第70轮规约）
        if (CAPS.indexOf(id) >= 0 && CAPS.every(x => d.found[x]) && !resDone) return '请选择阿尔意1、阿尔意2和阿尔C的整理方式，先整理哪一个都可以。点击阿尔意2的移除选项后，移除阿尔意2，同时把电路调整为，阿尔意1直接连到地。';"""),

# ---------- 3. hideVccLabel → hideVccLabelOnly + ensureGndRail（第71轮） ----------
("""    function hideVccLabel() {
        document.querySelectorAll('.vcc-label').forEach(t => { t.style.opacity = '0'; t.style.visibility = 'hidden'; });
    }""",
 """    // 第71轮：只隐藏指定电源端子的标注（'vcc' / 'vee'）。第4关两个电源都要置零接地，但 −V_EE 的
    // 标注必须保留显示（用户要求）：fx-vee 接地符号画在端子左下方(458~514)，与右侧标注(530 起)不重叠。
    function hideVccLabelOnly(which) {
        document.querySelectorAll(which === 'vee' ? '.vee-label' : '.vcc-label').forEach(t => { t.style.opacity = '0'; t.style.visibility = 'hidden'; });
    }
    // 两个电源端子都已收起的场合（等效态）用：连带隐藏两只标注
    function hideVccLabel() {
        document.querySelectorAll('.vcc-label, .vee-label').forEach(t => { t.style.opacity = '0'; t.style.visibility = 'hidden'; });
    }
    // 第71轮：整理电路时把底部多个独立接地符号收拢为「一处地 + 一条公共地母线」。
    //   第一次整理任一元件（RE2 移除 / RE1 保留 / R_C 下移）时调用：收起 V_s / R_B / C_E / R_L 四处
    //   接地符号与整理态 R_C 的接地符号，点亮 fx-gnd-rail；唯一保留 −V_EE 端子下方的 fx-vee。
    function ensureGndRail() {
        const d = S.draw[S.level - 1];
        if (!d || d.gndRail) return;
        d.gndRail = true;
        ['comp-gnd-src', 'comp-gnd-rb', 'comp-gnd-ce', 'comp-gnd-rl'].forEach(x => fadeGroup(x, true));
        showFx('fx-gnd-rc', false);
        showFx('fx-gnd-rail', true);
    }"""),

# ---------- 4. execAct：fadeWithFull + −V_EE / R_e2 / R_e1 动作 ----------
("""                list.forEach(x => fadeGroup(x));
                // 被移除回路里的特效件一并收起（C1 断开输入回路时，Vs 的短接桥随之消失）
                if (list.indexOf('comp-src') >= 0) showFx('fx-vs', false);
                const d = S.draw[S.level - 1];
                (c.fadeWhenAll || []).forEach(rule => {""",
 """                list.forEach(x => fadeGroup(x));
                // 被移除回路里的特效件一并收起（C_B 断开输入回路时，Vs 的短接桥随之消失）
                if (list.indexOf('comp-src') >= 0) showFx('fx-vs', false);
                const d = S.draw[S.level - 1];
                // 彻底移除清单（fadeWithFull）：节点圆与接地符号——断开后只剩两条导线，不再是节点，
                // 半隐的节点圆/接地符号会像残点，故此处 opacity 0
                const full = (c.fadeWithFull && c.fadeWithFull[id]) || [];
                full.forEach(x => fadeGroup(x, true));
                (c.fadeWhenAll || []).forEach(rule => {"""),
("""            case 'vcc-gnd':  showFx('fx-vcc', true); hideVccLabel(); break;
            case 'vcc-open': hideVccLabel(); break;
            case 'vcc-keep': break;
            case 're-remove':   // R_E 移除：原位换成短接导线（发射极经它接地），右侧 C_E 支路与发射极节点一并移除
                fadeGroup('comp-re', true); showFx('fx-re', true);
                ['wire-ce-a', 'wire-ce-b', 'node-ce', 'node-emitter'].forEach(x => fadeGroup(x, true));
                showFx('fx-ce', false);
                break;
            case 're-keep':  break;""",
 """            case 'vcc-gnd':  showFx('fx-vcc', true); hideVccLabelOnly('vcc'); break;
            case 'vcc-open': hideVccLabelOnly('vcc'); break;
            case 'vcc-keep': break;
            // −V_EE 置零接地：只画接地符号，标注保留显示（第71轮用户要求「第4关电路要有 −V_EE 文字」）
            case 'vee-gnd':  showFx('fx-vee', true); break;
            case 'vee-open': break;
            case 'vee-keep': break;
            // ★换案例：分段发射极电阻的去留（本电路关键，第71轮改写）
            //   RE2 被 C_E 完全旁路 → 整支移除（本体 + 上下引线）；RE1 下端经导线直接下接到 −V_EE
            //   端子，即交流地 —— 等价于 C_E 那条旁路支路「左移到 RE1 下端」，故其支路随之收起
            case 're2-remove':
                ensureGndRail();                                         // 第一个整理动作：底部地收拢为一条公共母线
                fadeGroup('comp-re2', true); fadeGroup('wire-re2-a', true); fadeGroup('wire-ree-b', true);
                fadeGroup('wire-ce-a', true); fadeGroup('wire-ce-b', true);
                fadeGroup('comp-ce', true);   // C_E 极板与标注一并收起（第72轮补：RE2 移除后 C_E 无被旁路对象，悬空极板属残件）
                showFx('fx-re2', false);      // 不再在位画绿短路线（改用下面的直连导线）
                showFx('fx-ce', false);       // C_E 短接桥收起（接地作用已由 RE1 下方直连导线承担）
                showFx('node-re', false);     // (486,470) 只剩「RE1 引线 + 直连导线」→ L 拐角，撤节点圆
                showFx('fx-re2-wire', true);  // RE1 下端 → −V_EE 端子(地) 的直连导线
                break;
            case 're2-keep':   break;
            //   RE1 未被 C_E 旁路 → 保留，等效态由 eq-re1 重新画在发射极节点与地之间
            case 're1-keep':   ensureGndRail(); break;
            case 're1-remove': break;"""),

# ---------- 5. showEquiv / moveCompDown：按本案例三层结构重写 ----------
("""    // 交流等效最终布局（第4关第3步选「等效」时启用）：
    // 移除晶体管本体后，基极输入线上升到 y=178 与集电极导线对齐，Vs/Rs/RB1/RB2 上移；
    // 旧 y=265 输入线、旧 Vs/Rs 列、整理态 R_B1/R_B2、发射极支路（r_be/受控源已直挂地线）全部收起
    // ★换案例：等效态切换（纯共射结构可直接沿用；新增状态层须在此同亮）
    function showEquiv() {
        ['wire-vi-top', 'wire-base-in', 'wire-base', 'comp-vi', 'wire-rs-top', 'comp-rs', 'wire-rs-bot', 'comp-src', 'wire-vi-gnd',
         'wire-rb2a', 'comp-rb2', 'wire-rb2b',
         'wire-emitter', 'wire-re-a', 'wire-re-b'].forEach(x => fadeGroup(x, true));
        // 受控源上方的集电极节点（此时只剩 2 条导线成直角，已非节点）一并移除
        fadeGroup('node-collector', true);
        // 集电极横导线缩短：左端由晶体管 C 端（486）收到交流等效的 C 节点（580，受控源支路挂点）——
        // 原整段导线（wire-collector 485→670）收起，改由 eq-layer 内的 560→670 段承担（见 eq-layer）
        fadeGroup('wire-collector', true);
        fadeGroup('wire-c-stub', true);   // 晶体管已移除，T 集电极—集电极导线之间的短接线一并收起（等效态导线由 eq-layer 承担）
        // rarr-rb1 / rarr-rb2lab 只有 id 没有 data-id，用 getElementById 收起
        showFx('rarr-rb1', false);
        showFx('rarr-rb2lab', false);
        // R_C 保持在整理态下挂位（x=640，与 R_L 并联）：等效后位置不变，学生视觉上不会跳变
        showFx('rarr-rc', true);
        const rcKeep = document.getElementById('rarr-rc');
        if (rcKeep) rcKeep.style.pointerEvents = 'all';
        showFx('fx-c1', false);
        showFx('fx-re', false);
        // eq-layer 与其中可作答的 eq-rb1 / eq-rb2 一起点亮（resetCircuit 会把它们 opacity 清零）
        ['eq-layer', 'eq-rb1', 'eq-rb2'].forEach(id => showFx(id, true));
        setCircuitShift(true);   // 整个电路图上移 40px，等效模型区域更宽松
        ['eq-rb1', 'eq-rb2'].forEach(id => { const el = document.getElementById(id); if (el) el.style.pointerEvents = 'all'; });
    }
    // 整理电路：R_B1 / R_C 上端的地下移并入地轨，电阻翻转下挂
    function moveCompDown(id) {
        const d = S.draw[S.level - 1];
        d.moved = d.moved || {};
        if (d.moved[id]) return;
        d.moved[id] = true;
        if (id === 'comp-rb1') {
            fadeGroup('comp-rb1', true); fadeGroup('wire-rb1a', true); fadeGroup('wire-rb1b', true);
            fadeGroup('wire-vcc-rail', true);   // 原RB1上端—R_C上端节点之间的顶部导线一并移除（RB1 已不接顶轨）
            showFx('node-rc-top', false);       // R_C 上方节点（原三线交汇点）随之移除
            showFx('rarr-rb1', true);
            const f1 = document.getElementById('rarr-rb1');
            if (f1) f1.style.pointerEvents = 'all';   // 下挂件可见后可点击（后续填空关作答用）
            // 原 R_B2 标签直接右移到整理态位（留在同一元件组内 → 悬停变金 / 作答变绿自动同步）
            document.querySelectorAll('.rb2-label').forEach(t => { t.setAttribute('x', '346'); t.setAttribute('y', '403'); t.setAttribute('text-anchor', 'start'); });
            // rarr-rb2lab 静态副本不再使用（原标签已原位右移）
        } else if (id === 'comp-rc') {
            fadeGroup('comp-rc', true); fadeGroup('wire-rc-top', true); fadeGroup('wire-rc-a', true);
            showFx('node-rc-top', false);       // R_C 下移后顶轨变直线，交汇节点消失
            fadeGroup('node-collector', true);  // R_C 下移（与 R_L 并联）后集电极只是导线折角，节点圆一并移除
            showFx('rarr-rc', true);
            const f2 = document.getElementById('rarr-rc');
            if (f2) f2.style.pointerEvents = 'all';
        }
        if (d.moved['comp-rb1'] && d.moved['comp-rc']) {   // 两个电阻都下移 → 顶部的地与下方地合并，收起顶轨与 +Vcc 端子
            ['wire-vcc-rail', 'wire-vcc-ext', 'comp-vcc'].forEach(x => fadeGroup(x, true));
            showFx('fx-vcc', false);
        }
        render();
    }""",
 """    function showEquiv() {
        // 输入侧：旧基极导线（y=260）与输入列全部收起，改由 eq-layer 的 y=190 基极线承担
        ['wire-vi-top', 'wire-base-in', 'wire-base', 'comp-vi', 'wire-rs-top', 'comp-rs', 'wire-rs-bot',
         'comp-src', 'wire-vi-gnd', 'node-base'].forEach(x => fadeGroup(x, true));
        // 基极偏置：默认态 R_B（基极节点 → 地）收起，等效态由 eq-rb 重新画在 y=190 基极线下方
        ['wire-rb-a', 'comp-rb', 'wire-rb-b'].forEach(x => fadeGroup(x, true));
        // 发射极支路：R_e1/R_e2/C_E/节点/−V_EE 全部收起，等效态由 eq-re1 + r_be + 受控源重画
        ['wire-emitter', 'comp-re1', 'wire-re1-b', 'node-re', 'wire-ce-a', 'comp-ce', 'wire-ce-b',
         'wire-re2-a', 'comp-re2', 'wire-ree-b', 'comp-vee'].forEach(x => fadeGroup(x, true));
        // 各独立接地符号收起（第66轮）：等效态的地由 eq-layer 的公共地轨（V_s 负极 → R_L 下端）表达，
        // 仅 R_e1 下端保留接地符号 fx-gnd-e
        ['comp-gnd-src', 'comp-gnd-rb', 'comp-gnd-rl', 'comp-gnd-ce'].forEach(x => fadeGroup(x, true));
        // 集电极节点与整段集电极导线：等效后 C 节点移到 x=560（受控源支路挂点），
        // 485→670 段收起，改由 eq-layer 内的 560→670 段承担（见 eq-layer）
        fadeGroup('node-collector', true);
        fadeGroup('wire-collector', true);
        fadeGroup('wire-c-stub', true);   // 晶体管已移除，T 集电极—集电极导线之间的短接线一并收起（等效态导线由 eq-layer 承担）
        // R_C 保持在整理态下挂位（x=640，与 R_L 并联）：等效后位置不变，学生视觉上不会跳变
        showFx('rarr-rc', true);
        const rcKeep = document.getElementById('rarr-rc');
        if (rcKeep) rcKeep.style.pointerEvents = 'all';
        showFx('fx-gnd-rc', false);     // 整理态 R_C 下端的接地符号收起（地由公共地轨表达）
        showFx('fx-gnd-rail', false);   // 整理态公共地母线收起（等效态的地由 eq-layer 的公共地轨表达）
        showFx('fx-gnd-jct', false);    // C_E/R_C 列并线段收起（第72轮自 fx-gnd-rail 拆出）
        showFx('fx-re2-wire', false);   // RE1 下端直连导线收起（等效态发射极支路由 eq-re1 重画）
        showFx('fx-gnd-e', true);       // 等效态发射极节点的接地符号
        showFx('fx-c1', false);         // C_B 短接桥在 eq-layer 内重画（y=190）
        showFx('fx-ce', false);         // C_E 短接桥收起（等效态发射极支路整体由 eq-re1 表达，残桥会悬在 R_C 下挂导线上）
        showFx('fx-re2', false);        // RE2 短路标记收起（等效态不再出现 RE2）
        showFx('fx-vee', false);        // −V_EE 接地标记收起（交流地已由 eq-layer 地轨 + fx-gnd-e 表达）
        hideVccLabel();                 // 两个电源端子此时已整体收起，标注一并隐藏
        // eq-layer 与其中可作答的 eq-rb / eq-re1 一起点亮（resetCircuit 会把它们 opacity 清零）
        ['eq-layer', 'eq-rb', 'eq-re1'].forEach(id => showFx(id, true));
        ['eq-rb', 'eq-re1'].forEach(id => { const el = document.getElementById(id); if (el) { el.style.pointerEvents = 'all'; el.classList.remove('hit-off'); } });
    }
    // 整理电路：R_C 上端（接 +V_CC，交流中该点已接地）翻转下挂，从集电极节点垂直接到地
    function moveCompDown(id) {
        const d = S.draw[S.level - 1];
        d.moved = d.moved || {};
        if (d.moved[id]) return;
        d.moved[id] = true;
        if (id === 'comp-rc') {
            fadeGroup('comp-rc', true); fadeGroup('wire-rc-top', true); fadeGroup('wire-rc-a', true);
            fadeGroup('node-collector', true);  // R_C 下移后集电极只剩 C_C 一条引线，已非节点
            showFx('rarr-rc', true);
            ensureGndRail();                 // 第一个整理动作就是 R_C 下移时，同时启用公共地母线
            showFx('fx-gnd-jct', true);      // R_C 底端(640)落母线行 → C_E/R_C 列并线段点亮（第72轮拆出）
            const f2 = document.getElementById('rarr-rc');
            if (f2) f2.style.pointerEvents = 'all';
            // R_C 下移即接入交流地 → 顶部电源轨与 +V_CC 端子两端均已悬空，一并收起，
            // fx-vcc 接地标记同时隐藏（交流地已由公共地母线 fx-gnd-rail 与 fx-gnd-e 表达）
            ['wire-vcc-rail', 'comp-vcc'].forEach(x => fadeGroup(x, true));
            showFx('fx-vcc', false);
        }
        render();
    }"""),

# ---------- 6. 下移菜单文案（本案例 R_C 与 R_L 并联） ----------
("""                const pair = id === 'comp-rb1'
                    ? [['与RB2串', false], ['与RB2并', true]]
                    : [['与RL串', false], ['与RL并', true]];""",
