# ---------- 36~39. 第4关状态位移（第91轮需求2/4：整理态上部上移15px接地不动 / 等效态保留件 +25 对齐 eq-layer）----------
#   位移清单与工具函数（顶层定义，resetCircuit/showEquiv/ensureGndRail 三处调用）
("""    function showEquiv() {""",
 """    // 第91轮：第4关整理态——上部电路整体上移 15px（下方接地系统 fx-gnd-rail/jct/tail/re2-wire/vee 不动）；
    //   等效态——仍保留的默认层件 +25 与 eq-layer（transform +25）的集电极横线/地轨对齐
    const TIDY_UP_IDS = ['comp-t', 'wire-c-stub', 'wire-collector', 'comp-c2', 'fx-c1', 'fx-c2',
        'wire-c2-out', 'wire-rl-a', 'comp-rl', 'wire-rl-b', 'comp-vo', 'rarr-rc',
        'wire-emitter', 'comp-re1', 'wire-re1-b', 'node-re',
        'wire-ce-a', 'wire-ce-b', 'comp-ce', 'fx-ce', 'wire-re2-a', 'comp-re2', 'fx-re2',
        'wire-vi-top', 'comp-vi', 'wire-rs-top', 'comp-rs', 'wire-rs-bot', 'fx-vs', 'wire-vi-gnd',
        'wire-rb-a', 'comp-rb', 'wire-rb-b',
        // 第92轮补：基极导线三件（260 行，漏移会与 C_B 桥错位）+ 电源轨两件与 +V_CC 接地标记
        'wire-base-in', 'wire-base', 'node-base', 'comp-vcc', 'wire-vcc-rail', 'fx-vcc'];
    const TIDY_KEEP_IDS = ['fx-c2', 'comp-c2', 'wire-c2-out', 'wire-rl-a', 'comp-rl', 'wire-rl-b',
        'comp-vo', 'rarr-rc'];
    function tidyEl(id) {
        return document.querySelector('#circuit-wrap g[data-id="' + id + '"]') || document.getElementById(id);
    }
    function tidyShift(sel, dy) {
        (sel === 'up' ? TIDY_UP_IDS : TIDY_KEEP_IDS).forEach(id => {
            const el = tidyEl(id);
            if (el) el.setAttribute('transform', 'translate(0,' + dy + ')');
        });
    }
    function tidyClear() {
        TIDY_UP_IDS.concat(TIDY_KEEP_IDS).forEach(id => {
            const el = tidyEl(id);
            if (el) el.removeAttribute('transform');
        });
    }
    function showEquiv() {"""),
# ensureGndRail：整理态位移 + 接缝补线（三条整理路径 re2-remove / re1-keep / moveCompDown(comp-rc) 均汇聚于此）
("""        showFx('fx-gnd-rc', false);
        showFx('fx-gnd-rail', true);""",
 """        showFx('fx-gnd-rc', false);
        showFx('fx-gnd-rail', true);
        tidyShift('up', -15);            // 第91轮：上部电路整体上移 15px，下方接地系统保持原位
        showFx('fx-tidy-lines', true);   // 第91轮：上移后与地轨母线顶(525)的 5 段接缝补线"""),
# showEquiv：保留件改 +25（与 eq-layer 对齐），整理态补线收起
("""        ['eq-layer', 'eq-rb', 'eq-re1'].forEach(id => showFx(id, true));
        ['eq-rb', 'eq-re1'].forEach(id => { const el = document.getElementById(id); if (el) { el.style.pointerEvents = 'all'; el.classList.remove('hit-off'); } });""",
 """        ['eq-layer', 'eq-rb', 'eq-re1'].forEach(id => showFx(id, true));
        ['eq-rb', 'eq-re1'].forEach(id => { const el = document.getElementById(id); if (el) { el.style.pointerEvents = 'all'; el.classList.remove('hit-off'); } });
        tidyShift('keep', 25);           // 第91轮：等效态保留件 +25，与 eq-layer 集电极横线(201)/地轨(550)直接相接
        showFx('fx-tidy-lines', false);  // 整理态接缝补线收起（保留件已平移到位）"""),
# ---------- 40. −V_EE 置零接地时同步隐藏 −V_EE 文字（第92轮需求1；71轮「保留文字」要求作废）----------
("""            // −V_EE 置零接地：只画接地符号，标注保留显示（第71轮用户要求「第4关电路要有 −V_EE 文字」）
            case 'vee-gnd':  showFx('fx-vee', true); break;""",
 """            // −V_EE 置零接地：画接地符号并隐藏 −V_EE 文字（第92轮用户要求；71轮「保留文字」作废）
            case 'vee-gnd':  showFx('fx-vee', true); hideVccLabelOnly('vee'); break;"""),
]
miss = []; dup = []
for a, b in REPS:
    n = s.count(a)
    if n == 0: miss.append(a[:78].replace('\n', '⏎')); continue
    if n > 1: dup.append('%dx %s' % (n, a[:78].replace('\n', '⏎')))
    s = s.replace(a, b, 1)
if miss:
    raise SystemExit('以下锚点未找到（模板已变，请同步更新 _patch_g3.py）:\n  - ' + '\n  - '.join(miss))
if dup:
    raise SystemExit('以下锚点非唯一（会替换到错误位置，请加长锚点）:\n  - ' + '\n  - '.join(dup))

s = s.replace("    // ===== 事件绑定（框架通用，勿改） =====",
              "    " + MARK + "\n\n    // ===== 事件绑定（框架通用，勿改） =====", 1)
wr(P, s)
print('cj-g3 引擎补丁已应用（%d 处）' % len(REPS))
