# ---------- 8. 第47轮：TQUIZ 问3 epos（组B 受控源 x=560，与 C 红点同竖直线） ----------
("ok: '受控源', epos: [530],", "ok: '受控源', epos: [560],"),

# ================= 第65轮：第2关多顺序 + 第3关两套方案（路线①基极优先 / 路线②发射极优先） =================
# ---------- 9. initState：注入路线/三方案辅助函数（mixRoute/mixSubsFor/mkMixState）+ S 新增 route / qPicked ----------
("""    function initState() {
        S = {
            score: 0, level: 1, msg: null, finished: false, selBox: null, levelStart: 0,
            levelScore: LEVELS.map(() => 0),""",
 """    // ---- 静态计算路线（第2关首步决定）与第3关三套框架/表达式方案（第65轮立、第76轮扩为三条）----
    //   route='eq'   先算 I_EQ：I_CQ≈□ → 简化 → I_BQ → V_CEQ（用 subs）
    //   route='cq'   先算 I_CQ（省 I_EQ）：I_CQ≈I_EQ → 简化 → I_BQ → V_CEQ（用 subsC）
    //   route='base' 基极优先：I_BQ → 简化 → I_CQ → V_CEQ（用 subsBase）
    function mixRoute() { const r = S.route; return (r === 'base' || r === 'cq') ? r : 'eq'; }
    function mixSubsFor(c) {
        if (!c) return [];
        const r = mixRoute();
        if (r === 'base') return c.subsBase || c.subs || [];
        if (r === 'cq') return c.subsC || c.subs || [];
        return c.subs || [];
    }
    // 块 qid 传导：无 qid 的子步沿用上一个带 qid 子步的 qid（框架 + 表达式成对同块 → 整块一起重排）
    function mixQids(subs) {
        let last = null;
        return subs.map(sb => { if (sb.qid) last = sb.qid; return last; });
    }
    function mkMixStep(sb) {
        return sb.type === 'fw'
            ? { type: 'fw', opts: shuffle(sb.frameworks), chosen: [], solved: false, rem: sb.qpts, pen: sb.pen || 2 }
            : { type: 'fill', blanks: sb.blanks.map(b => ({ ansIds: b.ansIds, label: b.label, labels: b.labels, grp: b.grp, full: b.pts, rem: b.pts, done: false })) };
    }
    function mkMixState(subs) {
        const steps = subs.map(mkMixStep);
        return { si: 0, subs: subs.slice(), steps: steps, stepsOrig: steps.slice() };
    }
    function initState() {
        S = {
            score: 0, level: 1, msg: null, finished: false, selBox: null, levelStart: 0, route: null, qPicked: [],
            levelScore: LEVELS.map(() => 0),"""),

# ---------- 10. initState：mix 状态改由 mkMixState 生成（第3关按路线取 subs/subsC/subsBase） ----------
("""            if (c.kind === 'mix') {
                // 框架 + 表达式交错：subs[].type='fw' → 三选项框架题；'fill' → 一行表达式（per-blank 分值）
                S.mix[i] = {
                    si: 0,
                    subs: c.subs.slice(),
                    steps: c.subs.map(sb => sb.type === 'fw'
                        ? { type: 'fw', opts: shuffle(sb.frameworks), chosen: [], solved: false, rem: sb.qpts, pen: sb.pen || 2 }
                        : { type: 'fill', blanks: sb.blanks.map(b => ({ ansIds: b.ansIds, label: b.label, labels: b.labels, grp: b.grp, full: b.pts, rem: b.pts, done: false })) })
                };
                S.mix[i].stepsOrig = S.mix[i].steps.slice();   // 子步重排的原序副本（arrangeMixSubs）
            }""",
 """            // 框架 + 表达式交错：subs[].type='fw' → 三选项框架题；'fill' → 一行表达式（per-blank 分值）
            // 第 3 关（静态）的 subs 由第 2 关所选路线决定 → mkMixState + mixSubsFor 生成
            if (c.kind === 'mix') S.mix[i] = mkMixState(mixSubsFor(c));"""),

# ---------- 11. 注入 qRouteOf（模板已原生提供 qSeqs/qLen/qAllIds/qAccept/qSpan，故仅补路线映射） ----------
("""    // 交错关子步重排：带 qid 的子步按第 2 关实际点选顺序排列（I_BQ 与 V_CEQ 可互换）；无 qid 的保持原序
    function arrangeMixSubs(i) {""",
 """    // 首步 id → 所在顺序对应的计算路线（routes 见区 C：eq / cq / base）
    function qRouteOf(c, id) {
        const ss = qSeqs(c), rt = c.routes || ['eq', 'cq', 'base'];
        for (let si = 0; si < ss.length; si++) if ([].concat(ss[si][0]).indexOf(id) >= 0) return rt[si] || 'eq';
        return 'eq';
    }
    // 交错关子步重排：带 qid 的子步按第 2 关实际点选顺序排列（I_BQ 与 V_CEQ 可互换）；无 qid 的保持原序
    function arrangeMixSubs(i) {"""),

# ---------- 11b. arrangeMixSubs：静态关先按路线换套，再按第2关实际点选顺序整块重排 ----------
("""    function arrangeMixSubs(i) {
        const c = LEVELS[i] && LEVELS[i].cfg, mx = S.mix[i];
        if (!c || c.kind !== 'mix' || !mx || !mx.stepsOrig) return;
        const qi = LEVELS.findIndex(function (L2) { return L2.kind === 'qorder'; });
        const picked = (qi >= 0 && S.qorder[qi] && S.qorder[qi].done) || [];
        const pos = function (id) { const k = id ? picked.indexOf(id) : -1; return k < 0 ? 999 : k; };
        const order = c.subs.map(function (sb, k) { return k; })
            .sort(function (a, b) { return pos(c.subs[a].qid) - pos(c.subs[b].qid); });
        mx.subs = order.map(function (k) { return c.subs[k]; });
        mx.steps = order.map(function (k) { return mx.stepsOrig[k]; });
    }""",
 """    function arrangeMixSubs(i) {
        const c = LEVELS[i] && LEVELS[i].cfg, mx = S.mix[i];
        if (!c || c.kind !== 'mix' || !mx) return;
        // 第76轮：静态 Q 点关先按第 2 关所选路线换套（eq / cq / base 三方案），再按实际点选顺序重排子步；
        //   排序键为「块 qid」（mixQids：框架与表达式同块）→ I_BQ 与 V_CEQ 两块随第 2 关点选先后互换
        const subs = (c.subsC || c.subsBase) ? mixSubsFor(c) : (c.subs || []);
        const steps = subs.map(mkMixStep);
        const keys = mixQids(subs);
        const qi = LEVELS.findIndex(function (L2) { return L2.kind === 'qorder'; });
        const picked = (qi >= 0 && S.qorder[qi] && S.qorder[qi].done) || [];
        const pos = function (id) { const k = id ? picked.indexOf(id) : -1; return k < 0 ? 999 : k; };
        const order = subs.map(function (sb, k) { return k; })
            .sort(function (a, b) { return pos(keys[a]) - pos(keys[b]); });
        mx.subs = order.map(function (k) { return subs[k]; });
        mx.steps = order.map(function (k) { return steps[k]; });
        mx.stepsOrig = steps.slice();
        mx.si = 0; S.selBox = null; S.mixQ[i] = undefined;
    }"""),

# ---------- 12. pickQorder：首步定路线 S.route + 记录 S.qPicked（renderQorder/statusOf 已由模板原生提供 qSpan） ----------
("""        const acc = qAccept(c, o.done);   // 多条合法路线取并集：下一步可接受的量
        if (acc.indexOf(id) >= 0) {
            o.done.push(id);
            o.next++;
            blinkGroup(id, '#34d399');""",
 """        const acc = qAccept(c, o.done);   // 多条合法顺序取并集
        if (acc.indexOf(id) >= 0) {
            if (o.done.length === 0) S.route = qRouteOf(c, id);   // 首步定路线（供第 3 关选择 subs / subsC / subsBase）
            o.done.push(id);
            o.next++;
            S.qPicked = o.done.slice();   // 第76轮：记录实际点击序列，第 3 关据此决定 I_BQ 与 V_CEQ 两块的先后
            blinkGroup(id, '#34d399');"""),


# ---------- 14. statusOf：mix 总步数按当前路线 ----------
("        if (c.kind === 'mix') return { done: S.mix[i].si, total: c.subs.length };",
 "        if (c.kind === 'mix') return { done: S.mix[i].si, total: (S.mix[i].subs || c.subs).length };"),


# ---------- 17. 调试钩子：?lvl=3&rt=eq|cq|base 预览第 3 关三套方案 ----------
("""        S.level = n;
        // 多子问框架关预览：?lvl=5&fq=2 直接看第 2 个指标""",
 """        S.level = n;
        // 路线预览：?lvl=3&rt=eq|cq|base 直接看第 3 关的对应方案（eq 先算 I_EQ / cq 先算 I_CQ / base 基极优先）
        //   emitter 为第65轮旧路线名，等价于 eq（兼容旧链接）
        const mr = location.search.match(/[?&]rt=(base|emitter|eq|cq)/);
        if (mr) { S.route = (mr[1] === 'emitter') ? 'eq' : mr[1]; if (S.mix[n - 1]) arrangeMixSubs(n - 1); }
        // 多子问框架关预览：?lvl=5&fq=2 直接看第 2 个指标"""),

# ---------- 18. setCircuitShift 基础位姿与区 B translate 同步（第66轮修复、第72轮 227→199） ----------
#   resetCircuit() 进第4关时把 circuit-wrap 写回基准值 —— 必须与区 B 的 translate(18,199) 一致
#   （第72轮整图上移 28：R_C 上端导线 55→27 减半），否则整图回落旧位姿、底部沉出可视区；
#   up 分支同步 -40 → 159。
("""        if (w) w.setAttribute('transform', 'translate(18, ' + (up ? 220 : 260) + ') scale(1)');""",
 """        if (w) w.setAttribute('transform', 'translate(18, ' + (up ? 159 : 199) + ') scale(1)');"""),

# ---------- 19. 第67轮：inkExtent 对嵌套分式的墨迹估算修正 ----------
#   分母含嵌套分式时，内层分子框顶 ≈ -1.19×fs（原按 -0.88×fs 低估），
#   导致外层分子抬得过高、内层分子框穿过外层分数线（cj-g3 第3关 I_CQ≈I_EQ 框架踩到）。
("""            else if (t.frac) { top = Math.min(top, -fs * 0.88); bot = Math.max(bot, fs * 0.88); }""",
 """            // 嵌套分式：top 按内层分子框顶实测 -1.19×fs 估（第67轮）；bot 为内层分母底 ≈0.59×fs
            else if (t.frac) { top = Math.min(top, -fs * 1.20); bot = Math.max(bot, fs * 0.62); }"""),

# ---------- 20. 第67轮：buildFrac 分母含嵌套分式时整体下移 ----------
#   让内层分子顶（-1.19fs）落到分数线下方 ~0.15fs，两侧到分数线间距对称（=gap）
("""        // 分子与分母到分数线的间距相等：以「分数线→分母墨迹顶端」为准，分子基线随之抬高，
        // 使「分子墨迹底端→分数线」的间距与其相同（墨迹范围用 inkExtent 估算，勿用 getBBox）
        const denBase = barY + fs * 0.96;""",
 """        // 分子与分母到分数线的间距相等：以「分数线→分母墨迹顶端」为准，分子基线随之抬高，
        // 使「分子墨迹底端→分数线」的间距与其相同（墨迹范围用 inkExtent 估算，勿用 getBBox）
        // 分母含嵌套分式时整体下移（第67轮）：内层分子顶 -1.19fs 须回到分数线下方
        const denHasFrac = (denToks || []).some(t => t.frac);
        const denBase = barY + fs * (denHasFrac ? 1.35 : 0.96);"""),

# ---------- 21. 第67轮：框架选项渲染按高度缩字（嵌套分式较高，原只按宽度缩） ----------
("""                let eg = placeExpr(g, f.tokens, fsz, 1290, y + plan.h / 2, col);
                const ew = eg.getBBox().width;
                if (ew > 420) { eg.remove(); placeExpr(g, f.tokens, fsz * 420 / ew, 1290, y + plan.h / 2, col); }""",
 """                let eg = placeExpr(g, f.tokens, fsz, 1290, y + plan.h / 2, col);
                const bb0 = eg.getBBox(), ew = bb0.width, eh = bb0.height;
                // 超宽或超高（嵌套分式）时整体缩字（第67轮加高度维度）
                if (ew > 420 || eh > plan.h - 10) { const sc = Math.min(420 / ew, (plan.h - 10) / eh); eg.remove(); placeExpr(g, f.tokens, fsz * sc, 1290, y + plan.h / 2, col); }"""),

# ---------- 22. mixFillDone：进入带 say 的子步时播报提示语 ----------
("""    function mixFillDone(i) {
        const mx = S.mix[i];
        if (mx.si >= mx.steps.length - 1) completeLevel();
        else { mx.si++; S.selBox = null; render(); }
    }""",
 """    function mixFillDone(i) {
        const mx = S.mix[i];
        if (mx.si >= mx.steps.length - 1) { completeLevel(); return; }
        mx.si++; S.selBox = null; render();
        // 第69轮：进入带 say 的子步（如「工程近似估算法简化」）时播报其提示语；第76轮改读当前路线子步
        const sb = mx.subs[mx.si];
        if (sb && sb.say) say(sb.say);
    }"""),

# ---------- 23. pickMixFw：框架答对推进后同样播报 say ----------
("""                say('回答正确，获得' + Math.round(st.rem) + '分。', () => {
                    mx.si++;
                    S.selBox = null;
                    render();
                });""",
 """                say('回答正确，获得' + Math.round(st.rem) + '分。', () => {
                    mx.si++;
                    S.selBox = null;
                    render();
                    // 第69轮：进入带 say 的子步时播报（第76轮改读当前路线子步）
